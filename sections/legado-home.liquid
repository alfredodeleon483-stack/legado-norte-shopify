<section class="ln-home">
  <div class="ln-hero">
    <div class="ln-hero__texture" aria-hidden="true"></div>
    <div class="ln-shell ln-hero__content">
      <p class="ln-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ln-hero__copy">{{ section.settings.copy }}</p>
      <div class="ln-actions">
        <a class="ln-button ln-button--light" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        <a class="ln-link" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="ln-hero__mark" aria-hidden="true">LN</p>
  </div>

  <div class="ln-benefits">
    <div class="ln-shell ln-benefits__grid">
      <div><span>01</span><strong>Envíos a todo México</strong><small>Rastreo en cada pedido</small></div>
      <div><span>02</span><strong>Pago seguro</strong><small>Compra con tranquilidad</small></div>
      <div><span>03</span><strong>Selección con carácter</strong><small>Estilo que trasciende</small></div>
      <div><span>04</span><strong>Atención cercana</strong><small>Estamos para ayudarte</small></div>
    </div>
  </div>

  <div class="ln-shell ln-categories">
    <div class="ln-heading-row">
      <div><p class="ln-eyebrow ln-eyebrow--dark">Explora tu estilo</p><h2>Colecciones del norte</h2></div>
      <a class="ln-link ln-link--dark" href="{{ routes.collections_url }}">Ver todas <span aria-hidden="true">→</span></a>
    </div>
    <div class="ln-categories__grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a class="ln-category ln-category--{{ forloop.index }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.title }}
            {% endif %}
            <span class="ln-category__veil"></span>
            <span class="ln-category__content"><small>{{ block.settings.kicker }}</small><strong>{{ block.settings.title }}</strong><em>Descubrir →</em></span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% assign featured_collection = section.settings.collection %}
  {% if featured_collection == blank %}
    {% assign featured_collection = collections.all %}
  {% endif %}
  <div class="ln-products">
    <div class="ln-shell">
      <div class="ln-heading-row">
        <div><p class="ln-eyebrow ln-eyebrow--dark">Recién llegados</p><h2>Nuevos estilos</h2></div>
        <a class="ln-link ln-link--dark" href="{{ featured_collection.url }}">Comprar todo <span aria-hidden="true">→</span></a>
      </div>
      <div class="ln-products__grid">
        {% for product in featured_collection.products limit: 8 %}
          <article class="ln-product">
            <a class="ln-product__media" href="{{ product.url }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 700, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.title }}
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
              {% unless product.available %}<span class="ln-product__badge">Agotado</span>{% endunless %}
            </a>
            <div class="ln-product__info"><a href="{{ product.url }}">{{ product.title }}</a><span>{{ product.price | money }}</span></div>
          </article>
        {% else %}
          {% for index in (1..4) %}
            <article class="ln-product"><div class="ln-product__media">{{ 'product-apparel-' | append: index | placeholder_svg_tag }}</div><div class="ln-product__info"><span>Próximamente</span></div></article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ln-story">
    <div class="ln-story__visual"><span>LEGADO</span><strong>NORTE</strong><small>MONTERREY · MÉXICO</small></div>
    <div class="ln-story__content">
      <p class="ln-eyebrow ln-eyebrow--dark">Nuestra esencia</p>
      <h2>Más que vestir vaquero</h2>
      <p>Legado Norte nace para quienes llevan sus raíces con orgullo. Elegimos piezas con presencia, calidad y carácter para acompañarte en el camino, del día a día a las grandes ocasiones.</p>
      <a class="ln-button ln-button--dark" href="{{ section.settings.story_link | default: routes.root_url }}">Conoce Legado Norte</a>
    </div>
  </div>

  <div class="ln-newsletter">
    <div class="ln-shell ln-newsletter__inner">
      <div><p class="ln-eyebrow">Sé parte del legado</p><h2>Recibe lanzamientos y promociones</h2><p>Entérate antes que nadie de nuevas colecciones y beneficios exclusivos.</p></div>
      {% form 'customer', class: 'ln-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="LnEmail-{{ section.id }}">Correo electrónico</label>
        <input id="LnEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Tu correo electrónico" required autocomplete="email">
        <button type="submit">Suscribirme</button>
        {% if form.posted_successfully? %}<p>Gracias por suscribirte.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ln-home{--ink:#17130f;--leather:#7a472c;--sand:#d6b98d;--bone:#f5f0e7;--line:rgba(23,19,15,.16);background:var(--bone);color:var(--ink)}
  .ln-shell{width:min(100% - 40px,1440px);margin-inline:auto}.ln-eyebrow{margin:0 0 18px;font:600 .72rem/1.2 var(--font-body--family);letter-spacing:.24em;text-transform:uppercase}.ln-eyebrow--dark{color:var(--leather)}
  .ln-hero{position:relative;isolation:isolate;min-height:min(760px,85svh);display:flex;align-items:flex-end;overflow:hidden;color:#fff;background:radial-gradient(circle at 78% 25%,rgba(214,185,141,.35),transparent 28%),linear-gradient(110deg,#120f0c 0%,#2f2118 52%,#78482c 100%)}
  .ln-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.7),rgba(0,0,0,.06));z-index:-1}.ln-hero__texture{position:absolute;inset:0;z-index:-2;opacity:.28;background:repeating-linear-gradient(118deg,transparent 0 30px,rgba(255,255,255,.04) 31px 32px)}
  .ln-hero__content{padding-block:150px 90px}.ln-hero h1{max-width:920px;margin:0;font:700 clamp(3.5rem,9vw,9rem)/.84 var(--font-heading--family);letter-spacing:-.055em;text-transform:uppercase}.ln-hero__copy{max-width:570px;margin:28px 0 0;font-size:clamp(1rem,1.5vw,1.3rem);line-height:1.6;color:rgba(255,255,255,.78)}
  .ln-actions{display:flex;align-items:center;gap:28px;margin-top:38px;flex-wrap:wrap}.ln-button{display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:13px 26px;text-decoration:none;text-transform:uppercase;letter-spacing:.12em;font-weight:700;font-size:.74rem;transition:transform .25s,background .25s}.ln-button:hover{transform:translateY(-2px)}.ln-button--light{background:#fff;color:var(--ink)}.ln-button--dark{background:var(--ink);color:#fff}.ln-link{color:inherit;text-decoration:none;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ln-link span{margin-left:9px}.ln-link--dark{color:var(--ink)}.ln-hero__mark{position:absolute;right:-.02em;bottom:-.28em;margin:0;color:rgba(255,255,255,.035);font:900 min(38vw,34rem)/1 var(--font-heading--family);letter-spacing:-.12em;pointer-events:none}
  .ln-benefits{background:var(--ink);color:#fff}.ln-benefits__grid{display:grid;grid-template-columns:repeat(4,1fr)}.ln-benefits__grid div{display:grid;grid-template-columns:auto 1fr;gap:2px 14px;padding:27px 25px;border-right:1px solid rgba(255,255,255,.12)}.ln-benefits__grid div:last-child{border:0}.ln-benefits span{grid-row:1/3;color:var(--sand);font-size:.7rem}.ln-benefits strong{font-size:.82rem;text-transform:uppercase;letter-spacing:.08em}.ln-benefits small{color:rgba(255,255,255,.55)}
  .ln-categories,.ln-products .ln-shell{padding-block:110px}.ln-heading-row{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:44px}.ln-heading-row h2,.ln-story h2,.ln-newsletter h2{margin:0;font:600 clamp(2.3rem,4.5vw,4.7rem)/.95 var(--font-heading--family);letter-spacing:-.04em}.ln-categories__grid{display:grid;grid-template-columns:1.15fr .85fr .85fr;gap:12px}.ln-category{position:relative;min-height:530px;overflow:hidden;color:#fff;text-decoration:none;background:linear-gradient(145deg,#2a211a,#815031)}.ln-category--2{background:linear-gradient(145deg,#5b4637,#b38c62)}.ln-category--3{background:linear-gradient(145deg,#1c1b1a,#5e5b55)}.ln-category img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.ln-category:hover img{transform:scale(1.03)}.ln-category__veil{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.76),transparent 65%)}.ln-category__content{position:absolute;inset:auto 30px 30px;display:flex;flex-direction:column;gap:8px}.ln-category__content small,.ln-category__content em{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-style:normal}.ln-category__content strong{font:600 clamp(2rem,3vw,3.4rem)/1 var(--font-heading--family)}
  .ln-products{background:#eee6da}.ln-products__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:38px 14px}.ln-product__media{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#ded3c3}.ln-product__media img,.ln-product__media svg{width:100%;height:100%;object-fit:cover;transition:transform .45s}.ln-product:hover img{transform:scale(1.025)}.ln-product__badge{position:absolute;top:12px;left:12px;background:var(--ink);color:#fff;padding:7px 10px;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase}.ln-product__info{display:flex;justify-content:space-between;gap:20px;padding-top:14px;font-size:.9rem}.ln-product__info a{color:inherit;text-decoration:none}.ln-product__info span:last-child{font-weight:700;white-space:nowrap}
  .ln-story{display:grid;grid-template-columns:1.05fr .95fr;min-height:680px}.ln-story__visual{display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(135deg,#201913,#69422d);color:#e5caa2;text-align:center}.ln-story__visual span{font:600 clamp(2.4rem,7vw,7rem)/.78 var(--font-heading--family);letter-spacing:.25em;margin-right:-.25em}.ln-story__visual strong{font:800 clamp(4.8rem,13vw,13rem)/.78 var(--font-heading--family);letter-spacing:-.08em}.ln-story__visual small{margin-top:30px;letter-spacing:.3em}.ln-story__content{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:80px clamp(40px,8vw,130px);background:#fff}.ln-story__content p:not(.ln-eyebrow){max-width:620px;margin:28px 0 36px;font-size:1.05rem;line-height:1.75;color:#5b5048}
  .ln-newsletter{background:var(--leather);color:#fff;padding-block:75px}.ln-newsletter__inner{display:grid;grid-template-columns:1fr .85fr;align-items:end;gap:80px}.ln-newsletter h2{max-width:720px}.ln-newsletter__inner>div>p:last-child{color:rgba(255,255,255,.7)}.ln-newsletter__form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid rgba(255,255,255,.55)}.ln-newsletter__form input{min-width:0;padding:18px 0;border:0;background:transparent;color:#fff;font:inherit}.ln-newsletter__form input::placeholder{color:rgba(255,255,255,.65)}.ln-newsletter__form button{border:0;background:transparent;color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:.1em;cursor:pointer}.ln-newsletter__form p,.ln-newsletter__form ul{grid-column:1/-1}
  @media(max-width:989px){.ln-benefits__grid{grid-template-columns:1fr 1fr}.ln-benefits__grid div:nth-child(2){border-right:0}.ln-benefits__grid div:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.12)}.ln-categories__grid{grid-template-columns:1fr 1fr}.ln-category:first-child{grid-column:1/-1}.ln-products__grid{grid-template-columns:1fr 1fr}.ln-story{grid-template-columns:1fr}.ln-story__visual{min-height:520px}.ln-newsletter__inner{grid-template-columns:1fr;gap:35px}}
  @media(max-width:749px){.ln-shell{width:min(100% - 28px,1440px)}.ln-hero{min-height:720px}.ln-hero__content{padding-block:120px 62px}.ln-hero h1{font-size:clamp(3.2rem,17vw,5.2rem)}.ln-benefits__grid{grid-template-columns:1fr}.ln-benefits__grid div{border-right:0;border-bottom:1px solid rgba(255,255,255,.12)!important;padding-inline:4px}.ln-benefits__grid div:last-child{border-bottom:0!important}.ln-categories,.ln-products .ln-shell{padding-block:72px}.ln-heading-row{align-items:flex-start;flex-direction:column;margin-bottom:30px}.ln-categories__grid{grid-template-columns:1fr}.ln-category:first-child{grid-column:auto}.ln-category{min-height:430px}.ln-products__grid{gap:28px 8px}.ln-product__info{display:grid;gap:5px;font-size:.78rem}.ln-story__visual{min-height:400px}.ln-story__content{padding:65px 24px}.ln-newsletter{padding-block:58px}.ln-newsletter__form{grid-template-columns:1fr}.ln-newsletter__form button{text-align:left;padding:14px 0}}
{% endstylesheet %}

{% schema %}
{
  "name": "Legado Norte · Inicio",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Texto superior","default":"Legado Norte · Monterrey"},
    {"type":"text","id":"heading","label":"Título","default":"El norte se lleva puesto"},
    {"type":"textarea","id":"copy","label":"Descripción","default":"Estilo vaquero contemporáneo, seleccionado para quienes hacen su propio camino."},
    {"type":"text","id":"primary_label","label":"Botón principal","default":"Comprar colección"},
    {"type":"url","id":"primary_link","label":"Enlace principal"},
    {"type":"text","id":"secondary_label","label":"Botón secundario","default":"Explorar categorías"},
    {"type":"url","id":"secondary_link","label":"Enlace secundario"},
    {"type":"collection","id":"collection","label":"Colección destacada"},
    {"type":"url","id":"story_link","label":"Enlace de nuestra historia"}
  ],
  "blocks": [
    {"type":"category","name":"Categoría","limit":3,"settings":[
      {"type":"image_picker","id":"image","label":"Imagen"},
      {"type":"text","id":"kicker","label":"Texto superior","default":"Colección"},
      {"type":"text","id":"title","label":"Título","default":"Camisas"},
      {"type":"url","id":"link","label":"Enlace"}
    ]}
  ],
  "presets": [{"name":"Legado Norte · Inicio","blocks":[{"type":"category","settings":{"kicker":"Esenciales del norte","title":"Camisas"}},{"type":"category","settings":{"kicker":"Para cada camino","title":"Botas"}},{"type":"category","settings":{"kicker":"El toque final","title":"Sombreros"}}]}]
}
{% endschema %}
